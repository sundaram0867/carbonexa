# Project records use browser mock storage by default. Switch to php only after
# the project and project-resource API routes have been implemented.
VITE_DATA_MODE=mock
VITE_API_BASE_URL=/api

# The dashboard defaults to OpenStreetMap so a Google billing account is not required.
VITE_MAP_PROVIDER=osm

# Optional Google Maps provider. Set VITE_MAP_PROVIDER=google and enable billing,
# or use a Google Maps Demo Key for prototyping.
VITE_GOOGLE_MAPS_API_KEY=your_restricted_browser_key

# Optional: replace DEMO_MAP_ID with a map ID from your Google Cloud project.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Server-side Gemini key for the AI Assistant. Keep this separate from the Maps key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# PHP API server origin used by the Vite development proxy.
PHP_API_ORIGIN=http://127.0.0.1:8000
